#!/usr/bin/env bash
# verify-release — check a tool repo against the canonical plugin-release
# playbook (see ../playbook/release-playbook.md).
#
# This is the executable form of the playbook: every assertion below is a
# release-readiness rule that, if violated, is a stale/inconsistent path that
# would otherwise be rediscovered by hand. Run it locally during release prep
# and as a CI gate.
#
#   verify-release [--repo <path>] [--denylist <file>] [--docs-allow <list>]
#                  [--payload-allow <list>] [--strict]
#
#   --repo          target repo (default: cwd)
#   --denylist      newline-separated proper-noun denylist file (names, handles,
#                   private command/project names). Overrides $PLUGIN_KIT_DENYLIST.
#   --docs-allow    comma/newline-separated allowlist of tracked docs/*.md paths that
#                   are genuinely public (default: docs/spec.md). Overrides
#                   $PLUGIN_KIT_DOCS_ALLOW. Any tracked docs/*.md not listed is WARNed
#                   as a candidate internal artifact (check [14]).
#   --payload-allow comma/newline-separated EXTRA payload allowlist patterns added to
#                   the minimum default (bin/, skills/, manifests, README, LICENSE,
#                   ...). Overrides $PLUGIN_KIT_PAYLOAD_ALLOW. Used by check [16].
#   --strict        treat WARN as failure too (exit 1 on any WARN)
#
# PRIVACY MODEL — this script is public; it must contain zero personal data.
#   * Personal *paths* are caught by generic patterns (/Users/<x>, /home/<x>)
#     that never name a person.
#   * Personal *proper nouns* (maintainer name, GitHub handle, private slash
#     commands, project codenames) are NOT hardcoded — they are injected at
#     runtime from --denylist or $PLUGIN_KIT_DENYLIST, which live outside this
#     repo. A public reader sees "scans against a configured denylist", never
#     its contents.
#   * The repo owner/org is *derived* from the target's git remote, not baked in.
set -uo pipefail

REPO="" DENYLIST_FILE="" DOCS_ALLOW="" PAYLOAD_ALLOW_EXTRA="" STRICT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO=$2; shift 2 ;;
    --denylist) DENYLIST_FILE=$2; shift 2 ;;
    --docs-allow) DOCS_ALLOW=$2; shift 2 ;;
    --payload-allow) PAYLOAD_ALLOW_EXTRA=$2; shift 2 ;;
    --strict) STRICT=1; shift ;;
    -h|--help) sed -n '2,29p' "$0"; exit 0 ;;
    *) echo "verify-release: unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$REPO" ] || REPO=$(pwd)
REPO=$(CDPATH= cd -- "$REPO" && pwd) || { echo "verify-release: bad --repo" >&2; exit 2; }
[ -e "$REPO/.git" ] || { echo "verify-release: not a git repo: $REPO" >&2; exit 2; }
# Resolve $0 through symlinks so sibling scripts (check-versions) are found even
# when this is invoked via a symlink on PATH (e.g. ~/.local/bin).
self="$0"; while [ -L "$self" ]; do t=$(readlink "$self"); case "$t" in /*) self="$t" ;; *) self="$(dirname "$self")/$t" ;; esac; done
KITBIN=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)  # resolve before cd-ing into target
KITROOT=$(dirname "$KITBIN")
# Shared definition of the target arch list (and launcher) — check [7] verifies
# the committed bin/ matches it, so it must read from the same source stage-binaries
# builds from, not a hardcoded copy.
# shellcheck source=lib-binaries.sh
. "$KITBIN/lib-binaries.sh"
# Word-boundary denylist matching, shared with check-history so [9] and the
# history scan agree on semantics (act-5972d5).
# shellcheck source=lib-denylist.sh
. "$KITBIN/lib-denylist.sh"
# Minimum payload allowlist, shared with stage-payload so [16] and the curation
# producer read one list and cannot drift (act-c3a9bb).
# shellcheck source=lib-payload.sh
. "$KITBIN/lib-payload.sh"
cd "$REPO"

FAILS=0 WARNS=0
red=$'\033[31m'; grn=$'\033[32m'; ylw=$'\033[33m'; dim=$'\033[2m'; rst=$'\033[0m'
[ -t 1 ] || { red=""; grn=""; ylw=""; dim=""; rst=""; }
pass() { printf '  %sPASS%s %s\n' "$grn" "$rst" "$1"; }
fail() { printf '  %sFAIL%s %s\n' "$red" "$rst" "$1"; FAILS=$((FAILS+1)); }
warn() { printf '  %sWARN%s %s\n' "$ylw" "$rst" "$1"; WARNS=$((WARNS+1)); }
info() { printf '       %s%s%s\n' "$dim" "$1" "$rst"; }

# JSON helper (python3 — no jq dependency).
jget() { python3 -c "import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception as e:
    print('__ERR__:'+str(e)); sys.exit(0)
cur=d
for k in sys.argv[2].split('.'):
    if k=='': continue
    if isinstance(cur,list):
        try: cur=cur[int(k)]
        except: print('__MISS__'); sys.exit(0)
    elif isinstance(cur,dict) and k in cur: cur=cur[k]
    else: print('__MISS__'); sys.exit(0)
print(cur if not isinstance(cur,(dict,list)) else json.dumps(cur))" "$1" "$2" 2>/dev/null; }
json_ok() { python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$1" 2>/dev/null; }

# Derive tool name and owner (owner from git remote — public identity, not personal).
TOOL=$(jget .claude-plugin/marketplace.json plugins.0.name)
case "$TOOL" in __*|"") TOOL=$(basename "$REPO") ;; esac
ORIGIN=$(git remote get-url origin 2>/dev/null || true)
OWNER=$(printf '%s' "$ORIGIN" | sed -nE 's#.*[/:]([^/]+)/[^/]+(\.git)?$#\1#p')
[ -n "$OWNER" ] || OWNER="<owner>"
IS_BINARY=0; [ -d "cmd/$TOOL" ] && IS_BINARY=1
# A tool-plugin repo is defined by its plugin manifests (.claude-plugin /
# .codex-plugin) or a compiled command (cmd/). A bare skills/ dir does NOT make a
# repo a plugin — a tooling repo (like this kit) can carry a maintainer skill
# without being treated as a distributable plugin. Other repos get only the
# hygiene/privacy checks, not the plugin-shape ones.
IS_PLUGIN_REPO=0
{ [ -d .claude-plugin ] || [ -d .codex-plugin ] || [ -d cmd ]; } && IS_PLUGIN_REPO=1

printf '%s== verify-release: %s ==%s  tool=%s owner=%s %s\n' \
  "$rst" "$REPO" "$rst" "$TOOL" "$OWNER" "$([ "$IS_BINARY" = 1 ] && echo '(binary)' || echo '(skill-only)')"

# Tracked-file list once (most checks scan the shipped surface, not gitignored cruft).
TRACKED=$(git ls-files)

[ "$IS_PLUGIN_REPO" = 0 ] && info "not a tool-plugin repo — running hygiene/privacy checks only"

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[1] per-repo self-marketplace"
MP=.claude-plugin/marketplace.json
if [ -f "$MP" ] && json_ok "$MP"; then
  src=$(jget "$MP" plugins.0.source)
  # Two valid shapes: the string "./" (per-repo self-marketplace, ships the whole
  # tracked tree) OR a curated-dist object source that points the install at a
  # stage-payload-built subtree (source "local"/"git-subdir" with path under ./dist).
  # The latter is what a tool adopts to enforce the payload allowlist [16] — accept
  # it here so adoption isn't self-blocked. Anything else is still a fail.
  srcpath=$(jget "$MP" plugins.0.source.path)
  if [ "$src" = "./" ]; then pass "marketplace.json present, source \"./\" (per-repo self-marketplace)"
  else
    case "$src" in
      \{*)  # object source (local / git-subdir / url)
        case "$srcpath" in
          ./dist|./dist/*) pass "marketplace.json present, curated-dist source (path \"$srcpath\") — install ships the stage-payload tree" ;;
          *) fail "marketplace.json object source path \"$srcpath\" is not under ./dist — a curated-payload source must point at the stage-payload-built dist/ (or use source \"./\")"; ;;
        esac ;;
      *) fail "marketplace.json source is \"$src\", expected \"./\" or a curated-dist object source (path under ./dist)"; ;;
    esac
  fi
  # Older Claude Code (e.g. 2.1.91) rejects a top-level "$schema" key in
  # marketplace.json under `plugin validate` (Unrecognized key). Current
  # releases accept it, so this is a forward/back-compat warn, not a fail.
  [ "$(jget "$MP" '$schema')" != "__MISS__" ] && warn "marketplace.json carries a top-level \"\$schema\" key — some Claude Code versions' \`plugin validate\` reject it (Unrecognized key); drop it unless a host you target needs it"
else fail "missing or invalid .claude-plugin/marketplace.json"; fi

echo "[2] manifests valid JSON + version lockstep"
jok=1
for m in .claude-plugin/plugin.json .codex-plugin/plugin.json "$MP" .agents/plugins/marketplace.json; do
  [ -f "$m" ] || continue
  json_ok "$m" || { fail "invalid JSON: $m"; jok=0; }
done
[ "$jok" = 1 ] && pass "all present manifests are valid JSON"
# Version lockstep via the canonical check-versions (SKILL.md metadata.version
# is the single source; all version-bearing manifests must match it).
if cvout=$("$KITBIN/check-versions" --repo "$REPO" 2>&1); then
  pass "version lockstep ($(printf '%s\n' "$cvout" | awk 'NR==1{print $NF}'))"
else
  fail "version lockstep (check-versions):"; printf '%s\n' "$cvout" | sed 's/^/         /'
fi

echo "[3] README leads with plugin install"
if [ -f README.md ]; then
  if grep -qiE "plugin marketplace add +$OWNER/$TOOL" README.md && grep -qiE "plugin install +$TOOL@$TOOL" README.md; then
    pln=$(grep -niE "plugin marketplace add +$OWNER/$TOOL" README.md | head -1 | cut -d: -f1)
    cln=$(grep -niE "curl .*install\.sh|go install " README.md | head -1 | cut -d: -f1)
    pass "README documents 'plugin marketplace add $OWNER/$TOOL' + 'install $TOOL@$TOOL'"
    if [ -n "$cln" ] && [ -n "$pln" ] && [ "$cln" -lt "$pln" ]; then
      warn "a binary-install line (curl/go install) appears before the plugin line — plugin should lead"
    fi
  else fail "README does not document the per-repo plugin install ('plugin marketplace add $OWNER/$TOOL' + 'install $TOOL@$TOOL')"; fi
else fail "no README.md"; fi

echo "[4] retired distribution paths absent"
hits=$(printf '%s\n' "$TRACKED" | while read -r f; do [ -f "$f" ] && grep -Il "agent-tools-release" "$f"; done)
if [ -z "$hits" ]; then pass "no 'agent-tools-release' references in tracked files"
else fail "tracked files still reference the retired 'agent-tools-release' distribution path:"; printf '%s' "$hits" | sed 's/^/         /'; fi
fi  # end plugin-shape checks [1]-[4]

echo "[5] pre-release drafts folded/removed"
# Scope to TRACKED files, not a raw filesystem find: only tracked files ship, and a
# find over the working tree descends into gitignored cruft — notably live git
# worktrees under .claude/worktrees/<name>/, each a full checkout whose own tracked
# drafts would false-FAIL this against the PARENT repo (act-4428ca).
drafts=$(printf '%s\n' "$TRACKED" | grep -E '\.(revised|annotated)\.md$' || true)
if [ -z "$drafts" ]; then pass "no .revised.md/.annotated.md drafts left in tree"
else fail "scope-review drafts still present (fold into canonical + delete before shipping):"; printf '%s\n' "$drafts" | sed 's/^/         /'; fi

echo "[6] single canonical skill tree"
# Tracked-file scan (not a filesystem find) for the same reason as [5]: a live
# .claude/worktrees/<name>/ copy of skills/*/SKILL.md is not source drift and must not
# be counted (act-4428ca). Only tracked SKILL.md trees are the shipped skill source.
skilltrees=$(printf '%s\n' "$TRACKED" | grep -E '(^|/)SKILL\.md$' || true)
n=$(printf '%s\n' "$skilltrees" | grep -c .)
if [ "$n" -le 1 ]; then pass "one SKILL.md (${skilltrees:-none})"
else fail "multiple SKILL.md trees — duplicate skill source drifts:"; printf '%s\n' "$skilltrees" | sed 's/^/         /'; fi

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[7] binary delivery into the plugin (binary tools)"
if [ "$IS_BINARY" = 1 ]; then
  # A "source":"./" marketplace installs only TRACKED files and /plugin install
  # never fetches GitHub Release assets — so the binary the MCP server launches
  # must be committed under bin/: the uname launcher plus one binary per arch.
  miss=""
  printf '%s\n' "$TRACKED" | grep -qx "bin/$TOOL" || miss="$miss bin/$TOOL(launcher)"
  for a in $KIT_ARCHES; do
    b="bin/$TOOL-${a%/*}-${a#*/}"
    printf '%s\n' "$TRACKED" | grep -qx "$b" || miss="$miss $b"
  done
  if [ -z "$miss" ]; then pass "committed bin/: launcher + per-arch binaries present ($KIT_ARCHES)"
  else fail "binary tool missing committed bin/ artifacts — run stage-binaries (un-gitignore bin/ first):$miss"; fi
  # Execute + version smoke test: the committed binary for THIS host must run AND
  # report metadata.version. Catches (a) a corrupt/wrong-arch commit or broken
  # launcher; (b) on macOS, an unsigned darwin/arm64 binary the kernel SIGKILLs
  # (the exact way a plugin installs yet fails to start for a Mac user); and (c) a
  # `dev`/stale stamp — under commit-to-main there is no release-time rebuild, so
  # the committed binary's own version IS the shipped version and must match the
  # single source. A wrong -ldflags var path is silently ignored by the linker, so
  # this is the only thing that catches it.
  hostos=$(uname -s | tr '[:upper:]' '[:lower:]')
  hostarch=$(uname -m); case "$hostarch" in x86_64|amd64) hostarch=amd64 ;; aarch64|arm64) hostarch=arm64 ;; esac
  WANT_VER=$("$KITBIN/skill-version" --repo "$REPO" 2>/dev/null)
  if [ -z "$miss" ] && [ -f "bin/$TOOL-$hostos-$hostarch" ]; then
    smoke=$("bin/$TOOL" version 2>&1); rc=$?
    if [ "$rc" -ge 128 ]; then
      fail "committed bin/$TOOL killed by signal $((rc-128)) on $hostos/$hostarch — corrupt or unsigned (darwin needs ad-hoc codesign; re-run stage-binaries on macOS)"
    elif [ -n "$WANT_VER" ] && ! printf '%s' "$smoke" | grep -qF "$WANT_VER"; then
      fail "committed bin/$TOOL reports '$(printf '%s' "$smoke" | head -1 | tr -d '\r')' but metadata.version is '$WANT_VER' — unstamped (dev) or stale binary; stage-binaries must -ldflags -X <module>/internal/version.Binary=$WANT_VER"
    else
      pass "committed bin/$TOOL executes on $hostos/$hostarch and reports v$WANT_VER"
    fi
  elif [ -z "$miss" ]; then
    info "no committed binary for this host ($hostos/$hostarch) — execute smoke test skipped"
  fi
  # MCP serverInfo.version must ALSO carry the release version. The `version`
  # smoke above only checks the `version` subcommand; a tool can pass that yet
  # hardcode a divergent version in its MCP server (ask shipped serverInfo 0.1.0
  # while the binary was 0.2.0 — a second version source that drifted). Drive an
  # initialize handshake against the staged host binary and assert serverInfo
  # matches the single stamped source. Only for binary tools shipping MCP; skip
  # if the binary isn't runnable here. macOS has no `timeout`, so bound via python.
  if [ -z "$miss" ] && [ -f "bin/$TOOL-$hostos-$hostarch" ] && [ -n "$WANT_VER" ] && { [ -f .mcp.json ] || [ -f .codex-plugin/plugin.json ]; }; then
    mcpver=$(python3 - "bin/$TOOL" <<'PY' 2>/dev/null
import sys, json, subprocess
init = json.dumps({"jsonrpc":"2.0","id":1,"method":"initialize","params":{
    "protocolVersion":"2024-11-05","capabilities":{},
    "clientInfo":{"name":"verify-release","version":"0"}}}) + "\n"
try:
    p = subprocess.run([sys.argv[1], "mcp"], input=init,
                       capture_output=True, text=True, timeout=15)
except Exception:
    sys.exit(0)
for line in p.stdout.splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        m = json.loads(line)
    except Exception:
        continue
    si = (m.get("result") or {}).get("serverInfo") or {}
    if si.get("version"):
        print(si["version"])
        break
PY
)
    if [ -z "$mcpver" ]; then
      warn "bin/$TOOL MCP serverInfo.version unreadable (server didn't answer initialize) — version-drift check skipped"
    elif [ "$mcpver" = "$WANT_VER" ]; then
      pass "bin/$TOOL MCP serverInfo.version ($mcpver) matches release version"
    else
      fail "bin/$TOOL MCP serverInfo.version '$mcpver' != release version '$WANT_VER' — a hardcoded MCP version drifted from the stamped source; source serverInfo from internal/version.Binary (\`<tool> version\` already does)"
    fi
  fi
  wf=$(grep -rliE "plugin-release-kit|release-plugin\.yml" .github/workflows 2>/dev/null)
  if [ -n "$wf" ]; then
    # The reusable prepare-release workflow commits to the default branch, so it
    # runs with contents:write — require an immutable SHA pin (not a moving
    # branch/tag), or a supply-chain change gains write access to the repo.
    badpin=$(grep -hoE "plugin-release-kit/[^@\"' ]*@[^ \"')]+" $wf 2>/dev/null | sed -E 's/.*@//' | grep -vE '^[0-9a-f]{40}$' | grep -v '^$' || true)
    if [ -n "$badpin" ]; then
      fail "reusable release workflow not pinned to a commit SHA (mutable ref '$badpin' = CI/CD supply-chain risk)"
    else
      # Drift signal: compare the tool's pinned kit SHA to the local kit HEAD.
      pinned=$(grep -hoE "plugin-release-kit/[^@\"' ]*@[0-9a-f]{40}" $wf 2>/dev/null | sed -E 's/.*@//' | head -1)
      kithead=$(git -C "$KITROOT" rev-parse HEAD 2>/dev/null)
      if [ -z "$pinned" ] || [ -z "$kithead" ]; then
        pass "release workflow wires + SHA-pins the prepare-release workflow"
      elif [ "$pinned" = "$kithead" ]; then
        pass "release workflow SHA-pinned to current kit HEAD (${pinned:0:7})"
      elif git -C "$KITROOT" cat-file -e "$pinned" 2>/dev/null && git -C "$KITROOT" merge-base --is-ancestor "$pinned" "$kithead" 2>/dev/null; then
        behind=$(git -C "$KITROOT" rev-list --count "$pinned".."$kithead" 2>/dev/null)
        warn "release workflow pins kit ${pinned:0:7} — $behind commit(s) behind kit HEAD ${kithead:0:7}; bump the pin deliberately to adopt kit updates"
      elif git -C "$KITROOT" cat-file -e "$pinned" 2>/dev/null; then
        pass "release workflow SHA-pinned (${pinned:0:7}; ahead of or diverged from local kit HEAD)"
      else
        warn "release workflow pins kit ${pinned:0:7} not in local kit history — git pull the kit to assess drift"
      fi
    fi
  else fail "no release workflow wires the plugin-release-kit reusable workflow — nothing builds/commits the binaries that /plugin install ships (wire the prepare-release workflow)"; fi
  # MCP startup does NOT get the plugin's bin/ on PATH (that's Bash-tool-only), so
  # the command must reference the bundled launcher by absolute path. Claude
  # expands ${CLAUDE_PLUGIN_ROOT} to the plugin root — the documented mechanism.
  if [ -f .mcp.json ]; then
    cmd=$(python3 -c "import json;d=json.load(open('.mcp.json'));s=d.get('mcpServers',{});print(next(iter(s.values()),{}).get('command','') if s else '')" 2>/dev/null)
    want="\${CLAUDE_PLUGIN_ROOT}/bin/$TOOL"
    if [ "$cmd" = "$want" ]; then pass ".mcp.json command \"$cmd\" targets the bundled launcher"
    else fail ".mcp.json command \"$cmd\" != \"$want\" — MCP startup has no plugin bin/ on PATH; use \${CLAUDE_PLUGIN_ROOT}"; fi
  fi
  # Codex reads the file .codex-plugin/plugin.json's mcpServers points to (it does
  # NOT auto-discover .mcp.json) and does NOT expand ${CLAUDE_PLUGIN_ROOT} — it
  # resolves a bundled binary via a relative command + a cwd joined to the plugin
  # root. Empirically (codex 0.141.0): command "./bin/<tool>", cwd ".". So a binary
  # tool shipping MCP on Codex needs a Codex-specific server def, separate from the
  # Claude .mcp.json above — one command string can't serve both hosts.
  if [ -f .codex-plugin/plugin.json ]; then
    cxptr=$(jget .codex-plugin/plugin.json mcpServers)
    cxfile=${cxptr#./}
    if [ "$cxptr" = "__MISS__" ]; then
      [ -f .mcp.json ] && warn "Codex .codex-plugin/plugin.json has no mcpServers pointer — Codex won't deliver bin/$TOOL's MCP server"
    elif [ "$cxptr" = "./.mcp.json" ]; then
      fail "Codex mcpServers points at the Claude .mcp.json (\${CLAUDE_PLUGIN_ROOT}, which Codex won't expand) — point it at a Codex-specific config: command \"./bin/$TOOL\", cwd \".\""
    elif [ -f "$cxfile" ]; then
      ccmd=$(python3 -c "import json;s=json.load(open('$cxfile')).get('mcpServers',{});print((next(iter(s.values()),{}) if s else {}).get('command',''))" 2>/dev/null)
      ccwd=$(python3 -c "import json;s=json.load(open('$cxfile')).get('mcpServers',{});print((next(iter(s.values()),{}) if s else {}).get('cwd',''))" 2>/dev/null)
      if [ "$ccmd" = "./bin/$TOOL" ] && [ "$ccwd" = "." ]; then
        pass "Codex MCP config $cxfile resolves bin/$TOOL (command \"$ccmd\", cwd \"$ccwd\")"
      else
        fail "Codex MCP config $cxfile: command \"$ccmd\" cwd \"$ccwd\" — Codex needs command \"./bin/$TOOL\" + cwd \".\" (it joins cwd to the plugin root; it does not expand \${CLAUDE_PLUGIN_ROOT})"
      fi
    fi
  fi
else info "skill-only tool — no binary-into-plugin requirement"; fi
fi  # end plugin-shape check [7]

echo "[8] no personal paths in shipped (tracked) files"
# Only UNAMBIGUOUS absolute home paths — never legitimate in a shipped repo.
# Personal tilde-dir conventions (a personal workspace root, etc.) are per-user
# judgment and live in the injected denylist, not in this public pattern (which
# also keeps legit standard paths like ~/.claude / ~/.codex from false-positiving).
ppat='/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+'
phits=$(printf '%s\n' "$TRACKED" | while read -r f; do
  [ -f "$f" ] || continue
  [[ "$f" == LICENSE* ]] && continue
  grep -IlnE "$ppat" "$f" 2>/dev/null
done)
if [ -z "$phits" ]; then pass "no absolute personal/home paths in tracked files"
else fail "tracked files contain personal/home paths (use repo-relative or generic placeholders):"; printf '%s\n' "$phits" | sed 's/^/         /'; fi

echo "[9] no proper-noun leaks (injected denylist)"
DL="$DENYLIST_FILE"; [ -n "$DL" ] || DL="${PLUGIN_KIT_DENYLIST:-}"
# Default to the conventional per-machine location so agents need not be handed
# a path — the denylist is private and never committed, but lives at a known spot.
[ -n "$DL" ] || DL="${XDG_CONFIG_HOME:-$HOME/.config}/plugin-release-kit/denylist"
if [ -n "$DL" ] && [ -f "$DL" ]; then
  terms=$(grep -vE '^\s*(#|$)' "$DL")
  dhits=""
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    # Word-boundary match (act-5972d5): a short token like "/qcm" must not
    # substring-match "launcher/qcmd". LC_ALL=C so BSD grep's negated bracket
    # class behaves under a UTF-8 login locale. -E for the ERE the helper builds.
    pat=$(dl_word_pattern "$t")
    h=$(printf '%s\n' "$TRACKED" | while read -r f; do
      [ -f "$f" ] || continue
      # Skip files where personal names are legitimate (author attribution).
      [[ "$f" == LICENSE* ]] && continue
      [[ "$f" == *.claude-plugin/*.json || "$f" == *.codex-plugin/*.json ]] && continue
      LC_ALL=C grep -IlE -- "$pat" "$f" 2>/dev/null && break
    done)
    [ -n "$h" ] && dhits="$dhits$t -> $(printf '%s' "$h" | tr '\n' ' ')"$'\n'
  done <<< "$terms"
  if [ -z "$dhits" ]; then pass "no denylisted proper nouns in tracked files"
  else fail "tracked files leak denylisted terms:"; printf '%s' "$dhits" | sed 's/^/         /'; fi
else
  warn "no denylist configured (--denylist or \$PLUGIN_KIT_DENYLIST) — proper-noun scan skipped"
fi

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[10] skill description within Codex 1024-char limit"
SK=$(printf '%s\n' "$skilltrees" | head -1)
if [ -n "$SK" ] && [ -f "$SK" ]; then
  dlen=$(python3 -c "
import sys,re
t=open(sys.argv[1]).read()
m=re.search(r'^---\n(.*?)\n---', t, re.S)
fm=m.group(1) if m else ''
dm=re.search(r'^description:\s*(.*)$', fm, re.M)
print(len(dm.group(1).strip()) if dm else -1)" "$SK" 2>/dev/null)
  if [ "$dlen" = "-1" ]; then warn "could not parse skill description in $SK"
  elif [ "$dlen" -le 1024 ]; then pass "skill description ${dlen}/1024 chars"
  else fail "skill description ${dlen} chars exceeds Codex 1024 limit ($SK)"; fi
fi
fi  # end plugin-shape check [10]

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[11] Codex packaging (.codex-plugin manifest + native marketplace)"
if [ -f .codex-plugin/plugin.json ]; then
  cpok=1
  # Component pointers must start with ./ and resolve; required when the
  # component is present in the tree (Codex does not auto-discover).
  sval=$(jget .codex-plugin/plugin.json skills)
  case "$sval" in
    __MISS__) [ -d skills ] && { fail ".codex-plugin/plugin.json: skills/ exists but no 'skills' pointer"; cpok=0; } ;;
    ./*) [ -e "$sval" ] || { fail ".codex-plugin/plugin.json: skills pointer '$sval' does not resolve"; cpok=0; } ;;
    *) fail ".codex-plugin/plugin.json: skills '$sval' must start with ./"; cpok=0 ;;
  esac
  mval=$(jget .codex-plugin/plugin.json mcpServers)
  case "$mval" in
    __MISS__) [ -f .mcp.json ] && { fail ".codex-plugin/plugin.json: .mcp.json exists but no 'mcpServers' pointer"; cpok=0; } ;;
    ./*) [ -e "$mval" ] || { fail ".codex-plugin/plugin.json: mcpServers pointer '$mval' does not resolve"; cpok=0; } ;;
    *) fail ".codex-plugin/plugin.json: mcpServers '$mval' must start with ./"; cpok=0 ;;
  esac
  [ "$cpok" = 1 ] && pass ".codex-plugin/plugin.json present; component pointers valid"
else
  fail ".codex-plugin/plugin.json missing — required for Codex packaging"
fi
CM=.agents/plugins/marketplace.json
if [ -f "$CM" ] && json_ok "$CM"; then
  cmok=1
  cver=$(jget "$CM" plugins.0.version)
  [ "$cver" != "__MISS__" ] && warn "$CM: plugins[].version present — Codex keeps version in the plugin manifest, not the marketplace"
  inst=$(jget "$CM" plugins.0.policy.installation)
  case "$inst" in AVAILABLE|INSTALLED_BY_DEFAULT|NOT_AVAILABLE) : ;; *) fail "$CM: policy.installation '$inst' invalid (AVAILABLE|INSTALLED_BY_DEFAULT|NOT_AVAILABLE)"; cmok=0 ;; esac
  # Enum values verified against real Codex (codex-cli 0.141.0 rejects ON_FIRST_USE:
  # "unknown variant, expected ON_INSTALL or ON_USE"). The kit previously generated
  # AND validated ON_FIRST_USE — producer and checker paraphrasing the same wrong
  # value, so it passed here yet blocked every real `codex plugin marketplace add`.
  authp=$(jget "$CM" plugins.0.policy.authentication)
  case "$authp" in ON_INSTALL|ON_USE) : ;; *) fail "$CM: policy.authentication '$authp' invalid (Codex accepts ON_INSTALL|ON_USE)"; cmok=0 ;; esac
  [ "$cmok" = 1 ] && pass "Codex-native marketplace present + valid policy ($CM)"
else
  fail "missing Codex-native marketplace $CM (Codex reads .agents/plugins/marketplace.json)"
fi
fi

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[12] vendor-neutral build doc (CLAUDE.md -> AGENTS.md)"
if [ -f CLAUDE.md ]; then
  clines=$(grep -cvE '^[[:space:]]*$' CLAUDE.md)
  if grep -qiE 'AGENTS\.md' CLAUDE.md || [ "$clines" -le 12 ]; then
    pass "CLAUDE.md is a thin pointer$([ -f AGENTS.md ] && echo ' (AGENTS.md present)')"
  else
    fail "CLAUDE.md is a substantive build doc ($clines lines) — ship build guidance as AGENTS.md (vendor-neutral); leave CLAUDE.md a thin pointer to it"
  fi
else
  pass "no vendor-named CLAUDE.md (build guidance in AGENTS.md/README)"
fi
fi

if [ "$IS_PLUGIN_REPO" = 1 ] && [ -f .claude-plugin/plugin.json ]; then
echo "[13] Claude manifest minimal (no component pointers — Claude auto-discovers)"
# Claude Code auto-discovers skills/ and .mcp.json, and its plugin.json schema
# REJECTS a "skills" key outright — `plugin install` fails with "skills: Invalid
# input" on affected releases (seen on 2.1.91). The skills/mcpServers pointers
# belong ONLY in .codex-plugin/plugin.json (check 11), which does not
# auto-discover. This is the Claude-side mirror of check 11: 11 asserts the
# Codex manifest HAS the pointer; this asserts the Claude manifest LACKS it.
cmok=1
case "$(jget .claude-plugin/plugin.json skills)" in
  __MISS__|__ERR__:*) ;;
  *) fail ".claude-plugin/plugin.json carries a 'skills' key — Claude Code rejects it (\`plugin install\` fails 'skills: Invalid input'). Drop it; Claude auto-discovers skills/. The pointer belongs only in .codex-plugin/plugin.json (check 11)."; cmok=0 ;;
esac
case "$(jget .claude-plugin/plugin.json mcpServers)" in
  __MISS__|__ERR__:*) ;;
  *) fail ".claude-plugin/plugin.json carries an 'mcpServers' key — Claude auto-discovers .mcp.json. Drop it; the pointer belongs only in .codex-plugin/plugin.json (check 11)."; cmok=0 ;;
esac
[ "$cmok" = 1 ] && pass ".claude-plugin/plugin.json carries no skills/mcpServers pointers (Claude auto-discovers)"
fi

echo "[14] tracked docs/ reviewed for internal artifacts"
# ask 0.1.0 shipped docs/distribution-readiness.md — an internal readiness note —
# to its public repo. It passed [8]/[9] (no personal paths, no denylisted nouns:
# internal design prose carries neither), so the "is this an internal doc that
# should not ship?" judgment was a human step, and it got skipped. The kit can't
# know which docs are public per tool, so it SURFACES every tracked docs/*.md not
# in a small allowlist as a candidate internal artifact to untrack before a public
# flip. WARN (a review prompt), never FAIL — false positives cost only a glance.
#
# Allowlist: genuinely-public doc paths (repo-relative). Default below; extend
# per-tool with --docs-allow "docs/a.md,docs/b.md" or $PLUGIN_KIT_DOCS_ALLOW
# (comma- or newline-separated).
DA="$DOCS_ALLOW"; [ -n "$DA" ] || DA="${PLUGIN_KIT_DOCS_ALLOW:-}"
[ -n "$DA" ] || DA="docs/spec.md"
docs_allow=$(printf '%s' "$DA" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' || true)
docmiss=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # case globbing: * spans '/', so this matches docs/x.md and docs/sub/y.md alike.
  case "$f" in docs/*.md) ;; *) continue ;; esac
  printf '%s\n' "$docs_allow" | grep -qxF -- "$f" && continue
  docmiss="$docmiss  $f"$'\n'
done <<EOF
$TRACKED
EOF
if [ -z "$docmiss" ]; then
  pass "no tracked docs/*.md outside the allowlist"
else
  warn "tracked docs/*.md outside the allowlist — candidate internal artifacts; untrack (gitignore) or add to --docs-allow before flipping public:"
  printf '%s' "$docmiss" | sed 's/^/       /'
fi

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[15] CHANGELOG carries release notes"
# Commit-to-main has no git tag or GitHub Release to hold the release body, so the
# CHANGELOG is the only place it lives — and bump-version deliberately leaves it to
# the human. Guard (via the canonical check-changelog) that a release isn't cut with
# a blank changelog: fail on a present-but-empty CHANGELOG, skip when there's none.
if clout=$("$KITBIN/check-changelog" --repo "$REPO" 2>&1); then
  case "$clout" in
    *"no CHANGELOG.md"*) info "no CHANGELOG.md — changelog guard skipped" ;;
    *) pass "${clout#CHANGELOG.md: }" ;;
  esac
else
  fail "CHANGELOG has no release notes (draft with: check-changelog --draft):"
  printf '%s\n' "$clout" | sed 's/^/         /'
fi
fi

if [ "$IS_PLUGIN_REPO" = 1 ]; then
echo "[16] shipped payload curated to a minimum allowlist"
# `/plugin install` ships every tracked file of a "source":"./" repo — the whole dev
# work tree, not a curated product. This check makes the payload an ALLOWLIST (not a
# denylist): it structurally prevents shipping anything unlisted, which is the
# act-aa46c3 class (an internal docs/*.md that carries no denylisted token slips past
# [8]/[9] but can never enter an allowlisted payload). The allowlist lives once in
# lib-payload.sh, shared with the stage-payload producer so they can't drift.
#
# Two teeth + a surface:
#   (a) COMPLETENESS (always on): every load-bearing file a tool ships (manifests,
#       skills SKILL.md trees, .mcp.json, the binary launcher + per-arch binaries)
#       must be INSIDE the allowlist — else the curated install would drop it. FAIL.
#   (b) SUBSET (adopted tools): if the marketplace source already points at a curated
#       dist/, its tree must be a subset of the allowlist — a stray file would ship. FAIL.
#   (c) SURFACE: the excluded (dev/process) files are listed so nothing load-bearing is
#       silently dropped, and an un-adopted tool is told its install still ships everything.
EXTRA_PA="$PAYLOAD_ALLOW_EXTRA"; [ -n "$EXTRA_PA" ] || EXTRA_PA="${PLUGIN_KIT_PAYLOAD_ALLOW:-}"
part=$(printf '%s\n' "$TRACKED" | payload_partition "$EXTRA_PA")
pl_ship=$(printf '%s\n' "$part" | sed -n 's/^SHIP\t//p')
pl_drop=$(printf '%s\n' "$part" | sed -n 's/^DROP\t//p')
pl_nship=$(printf '%s\n' "$pl_ship" | grep -c . || true)
pl_ndrop=$(printf '%s\n' "$pl_drop" | grep -c . || true)

# Load-bearing set — DERIVED from the same signals the other checks use, never a
# per-tool literal. Only files that are actually tracked are asserted.
lb=""
for m in .claude-plugin/marketplace.json .claude-plugin/plugin.json \
         .codex-plugin/plugin.json .agents/plugins/marketplace.json .mcp.json; do
  [ -f "$m" ] && lb="$lb$m"$'\n'
done
lb="$lb$(printf '%s\n' "$TRACKED" | grep -E '^skills/.*(^|/)SKILL\.md$' || true)"$'\n'
# The file the Codex manifest points mcpServers at must itself ship.
if [ -f .codex-plugin/plugin.json ]; then
  cxptr=$(jget .codex-plugin/plugin.json mcpServers); cxfile=${cxptr#./}
  [ "$cxptr" != "__MISS__" ] && [ -n "$cxfile" ] && [ -f "$cxfile" ] && lb="$lb$cxfile"$'\n'
fi
if [ "$IS_BINARY" = 1 ]; then
  lb="$lb""bin/$TOOL"$'\n'
  for a in $KIT_ARCHES; do lb="$lb""bin/$TOOL-${a%/*}-${a#*/}"$'\n'; done
fi
lb="$lb""README.md"$'\n'
lic=$(printf '%s\n' "$TRACKED" | grep -E '^LICENSE' | head -1); [ -n "$lic" ] && lb="$lb$lic"$'\n'

pl_missing=""
while IFS= read -r lbf; do
  [ -n "$lbf" ] || continue
  printf '%s\n' "$TRACKED" | grep -qxF -- "$lbf" || continue    # assert only on tracked files
  printf '%s\n' "$pl_ship" | grep -qxF -- "$lbf" || pl_missing="$pl_missing  $lbf"$'\n'
done <<EOF
$lb
EOF

if [ -n "$pl_missing" ]; then
  fail "load-bearing files fall OUTSIDE the payload allowlist — a curated install would DROP them; widen lib-payload.sh (or --payload-allow):"
  printf '%s' "$pl_missing" | sed 's/^/       /'
else
  pass "payload allowlist covers all load-bearing files ($pl_nship ship, $pl_ndrop excluded)"
fi

# (b) SUBSET teeth for a tool that has already adopted a curated-dist source.
mp_srcpath=$(jget "$MP" plugins.0.source.path 2>/dev/null)
mp_src=$(jget "$MP" plugins.0.source 2>/dev/null)
case "$mp_srcpath" in
  ./dist|./dist/*)
    distroot=${mp_srcpath#./}
    distfiles=$(printf '%s\n' "$TRACKED" | sed -n "s#^${distroot}/##p")
    stray=$(printf '%s\n' "$distfiles" | payload_partition "$EXTRA_PA" | sed -n 's/^DROP\t//p')
    if [ -n "$stray" ]; then
      fail "curated dist ($distroot/) carries files OUTSIDE the payload allowlist — they would ship; rebuild with stage-payload:"
      printf '%s\n' "$stray" | sed 's/^/         /'
    else
      pass "curated dist ($distroot/) payload is a subset of the allowlist"
    fi ;;
  *)
    # Un-adopted: still ships the whole tree. Not a FAIL (adoption is per-tool and
    # deliberate) — surface it so the gap is visible.
    [ "$mp_src" = "./" ] && [ "$pl_ndrop" -gt 0 ] && \
      info "marketplace source is still \"./\" — the install currently ships all $((pl_nship+pl_ndrop)) tracked files; adopt the curated dist source (stage-payload + source -> ./dist) to enforce the allowlist" ;;
esac

# (c) SURFACE the excluded set so nothing load-bearing hides among the exclusions.
if [ "$pl_ndrop" -gt 0 ]; then
  info "excluded from the payload ($pl_ndrop dev/process file(s) — not product):"
  printf '%s\n' "$pl_drop" | sed 's/^/         /'
fi
fi

echo
total=$((FAILS+WARNS))
if [ "$FAILS" -gt 0 ]; then
  printf '%s%d FAIL%s, %d WARN — not release-ready\n' "$red" "$FAILS" "$rst" "$WARNS"
  exit 1
elif [ "$WARNS" -gt 0 ] && [ "$STRICT" = 1 ]; then
  printf '%s%d WARN%s (strict) — not release-ready\n' "$ylw" "$WARNS" "$rst"
  exit 1
elif [ "$WARNS" -gt 0 ]; then
  printf '%s0 FAIL, %d WARN%s — release-ready (review warnings)\n' "$grn" "$WARNS" "$rst"
  exit 0
else
  printf '%sall checks pass — release-ready%s\n' "$grn" "$rst"
  exit 0
fi
