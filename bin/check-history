#!/usr/bin/env bash
# check-history — scan a tool repo's FULL git history for leaked personal data.
#
# verify-release [8]/[9] catch leaks in the WORKING TREE (what ships now).
# This catches leaks that exist in PAST commits — e.g. a repo developed/pushed
# before the scrub discipline, where a personal path or private name was once
# committed and later removed. The working tree can be clean while history is not.
#
# Use it to ANSWER "does this repo need a privacy-repave before going public?":
#   exit 0  => history is clean; no repave needed.
#   exit 1  => history carries leaks; repave (squash from a clean snapshot) first.
#
# Same privacy model as verify-release: generic patterns (home paths, card and
# account-number fragments) are built in; proper nouns come from an injected
# denylist (plus its <denylist>.d/ directory), never hardcoded. Patterns and
# denylist resolution are shared with verify-release via lib-privacy.sh.
#
#   check-history [--repo <path>] [--denylist <file>]
set -uo pipefail

REPO="" DL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO=$2; shift 2 ;;
    --denylist) DL=$2; shift 2 ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "check-history: unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$REPO" ] || REPO=$(pwd)
[ -e "$REPO/.git" ] || { echo "check-history: not a git repo: $REPO" >&2; exit 2; }

# Resolve $0 through symlinks so the sibling helper is found even when invoked
# via a symlink on PATH, then source the shared word-boundary matcher so this
# scan and verify-release [8]/[9] agree on patterns and semantics (act-5972d5).
self="$0"; while [ -L "$self" ]; do l=$(readlink "$self"); case "$l" in /*) self="$l" ;; *) self="$(dirname "$self")/$l" ;; esac; done
KITBIN=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
# shellcheck source=lib-privacy.sh
. "$KITBIN/lib-privacy.sh"
DL=$(priv_resolve_denylist "$DL")

red=$'\033[31m'; grn=$'\033[32m'; ylw=$'\033[33m'; rst=$'\033[0m'
[ -t 1 ] || { red=""; grn=""; ylw=""; rst=""; }

ncommits=$(git -C "$REPO" rev-list --all --count 2>/dev/null || echo 0)
printf '== check-history: %s ==  (%s commits)\n' "$REPO" "$ncommits"

FOUND=0

# Files where a personal name is legitimate (author attribution), exempted exactly
# as verify-release [8]/[9] exempt them: LICENSE* everywhere, plugin manifests for
# the proper-noun scan. Without this, a LICENSE naming its author fails history on
# the very line the playbook calls fine.
EXEMPT_PATHS=(':(exclude)LICENSE*')
EXEMPT_NOUNS=(':(exclude)LICENSE*' ':(exclude,glob)**/.claude-plugin/*.json' ':(exclude,glob)**/.codex-plugin/*.json')

# Generic absolute home paths — never legitimate anywhere in history.
# Pickaxe over diffs: commits whose diff added/removed a matching line.
phits=$(git -C "$REPO" log --all --format='  %h %ad %s' --date=short -G "$PRIV_PATH_ERE" -- . "${EXEMPT_PATHS[@]}" 2>/dev/null | head -20)
if [ -n "$phits" ]; then
  printf '%sLEAK%s personal/home paths appear in history (commits that touched them):\n' "$red" "$rst"
  printf '%s\n' "$phits"
  FOUND=1
fi

# Card and account-number fragments (the generic pattern in lib-privacy.sh), so
# a card tail nobody thought to denylist is still caught. Files the repo declares
# synthetic in .privacy-fixtures (read from the working tree) are skipped for
# this pattern only, exactly as in the working-tree check.
EXEMPT_CARDS=("${EXEMPT_PATHS[@]}")
while IFS= read -r g; do [ -n "$g" ] && EXEMPT_CARDS+=(":(exclude,glob)$g"); done <<EOF
$(priv_fixture_globs "$REPO")
EOF
chits=$(git -C "$REPO" log --all --format='  %h %ad %s' --date=short -G "$PRIV_CARD_ERE" -- . "${EXEMPT_CARDS[@]}" 2>/dev/null | head -20)
if [ -n "$chits" ]; then
  printf '%sLEAK%s card/account-number fragments appear in history (commits that touched them):\n' "$red" "$rst"
  printf '%s\n' "$chits"
  FOUND=1
fi

# Injected proper-noun denylist. Match via the -G pickaxe (diff-text), NOT -S
# (blob-content): -S counts occurrences in the raw blob, so under commit-to-main
# it matches a denylist substring sitting incidentally inside a committed BINARY
# (e.g. a short slash-prefixed command token appearing as a substring of a package
# path like "internal/foo/foo.go" in the binary's symbol table), spuriously
# flagging every binary-bearing commit as leaked history. -G operates on the
# textual diff, which is empty for binary files, so it skips them while still
# catching every real text-file leak. -G takes a regex; dl_word_pattern (shared
# lib) ERE-escapes each term AND anchors its alphanumeric edges to word
# boundaries, so a token like "/qcm" no longer substring-matches "launcher/qcmd"
# (act-5972d5).
if [ -n "$(priv_denylist_sources "$DL")" ]; then
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    h=$(git -C "$REPO" log --all --format='  %h %ad %s' --date=short -G "$(dl_word_pattern "$t")" -- . "${EXEMPT_NOUNS[@]}" 2>/dev/null | head -5)
    if [ -n "$h" ]; then
      printf '%sLEAK%s denylisted term %s appears in history:\n' "$red" "$rst" "\"$t\""
      printf '%s\n' "$h"
      FOUND=1
    fi
  done <<EOF
$(priv_denylist_terms "$DL")
EOF
else
  printf '%sWARN%s no denylist (--denylist, $PLUGIN_KIT_DENYLIST, or %s[.d/]) — proper-noun history scan skipped\n' "$ylw" "$rst" "$DL"
fi

echo
if [ "$FOUND" = 0 ]; then
  printf '%shistory is clean — no privacy-repave needed%s\n' "$grn" "$rst"
  exit 0
else
  printf '%shistory carries leaks — repave (squash from a clean snapshot) before going public%s\n' "$red" "$rst"
  exit 1
fi
